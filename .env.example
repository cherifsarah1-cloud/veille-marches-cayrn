# Copier ce fichier en .env et remplir les valeurs

# Obligatoire
ANTHROPIC_API_KEY=sk-ant-...

# Optionnel (necessaire uniquement pour l'envoi email)
SENDGRID_API_KEY=SG....
# A DEFINIR : destinataire(s) cote Symbiose (pas la meme personne que l'agent OPTIMA)
EMAIL_DESTINATAIRES=symbiose@cosygroup.fr
EMAIL_EXPEDITEUR=veille-symbiose@cosygroup.fr
# A remplacer par l'URL du repo GitHub Pages une fois cree
DASHBOARD_URL=https://TON_ORG.github.io/veille-marches-symbiose/
